# OSRM routing API base URL (default: public demo server)
OSRM_URL=https://router.project-osrm.org

# Nominatim geocoding API base URL (fallback; default: OpenStreetMap)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# PDOK Locatieserver base URL (address suggestions + primary geocoding)
PDOK_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1

# User agent for API requests (required by Nominatim usage policy)
USER_AGENT=TaxiCheck/2.0
