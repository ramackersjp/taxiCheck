# OSRM routing API base URL (default: public demo server)
OSRM_URL=https://router.project-osrm.org

# Nominatim geocoding API base URL (default: OpenStreetMap)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# User agent for API requests (required by Nominatim usage policy)
USER_AGENT=TaxiCheck/1.0
